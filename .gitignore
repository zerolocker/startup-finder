*.log
.DS_Store

# Raw upstream payloads and cached LLM responses: large, re-fetchable, and pure
# noise in diffs. Everything downstream of them — data/runs/*.jsonl and
# data/index.json — IS committed on purpose. See docs/ARCHITECTURE.md.
data/cache/

# The grading export, on its way into data/labels.jsonl via the
# review-startups skill. Transient by design.
labels.json

# Per-run logs. Machine-specific and regenerated; the durable record of what a
# run produced is data/index.json and the shard.
logs/
