{
  "name": "startup-finder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A personal research assistant that finds recently-funded startups worth joining or investing in.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "startup-finder": "./src/cli.ts"
  },
  "scripts": {
    "sf": "tsx src/cli.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
