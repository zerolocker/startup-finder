{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-main-branch.sh\"",
            "timeout": 10,
            "statusMessage": "Checking branch"
          }
        ]
      }
    ]
  }
}
